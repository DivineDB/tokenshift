{
  "color": {
    "brand": {
      "primary": {
        "$value": "#6470f3",
        "$type": "color",
        "$description": "Primary brand color — indigo-violet"
      },
      "primary-hover": {
        "$value": "#4f52e7",
        "$type": "color"
      },
      "primary-light": {
        "$value": "#e0e9ff",
        "$type": "color"
      },
      "primary-dark": {
        "$value": "#3535a4",
        "$type": "color"
      },
      "secondary": {
        "$value": "#7c3aed",
        "$type": "color",
        "$description": "Secondary purple accent"
      },
      "accent": {
        "$value": "#06b6d4",
        "$type": "color",
        "$description": "Teal accent for highlights"
      }
    },
    "neutral": {
      "50":  { "$value": "#f8fafc", "$type": "color" },
      "100": { "$value": "#f1f5f9", "$type": "color" },
      "200": { "$value": "#e2e8f0", "$type": "color" },
      "300": { "$value": "#cbd5e1", "$type": "color" },
      "400": { "$value": "#94a3b8", "$type": "color" },
      "500": { "$value": "#64748b", "$type": "color" },
      "600": { "$value": "#475569", "$type": "color" },
      "700": { "$value": "#334155", "$type": "color" },
      "800": { "$value": "#1e293b", "$type": "color" },
      "900": { "$value": "#0f172a", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#10b981", "$type": "color" },
      "warning": { "$value": "#f59e0b", "$type": "color" },
      "error":   { "$value": "#ef4444", "$type": "color" },
      "info":    { "$value": "#3b82f6", "$type": "color" }
    },
    "surface": {
      "background": { "$value": "#0f172a", "$type": "color" },
      "card":        { "$value": "#1e293b", "$type": "color" },
      "card-hover":  { "$value": "#263349", "$type": "color" },
      "border":      { "$value": "#334155", "$type": "color" }
    }
  },
  "spacing": {
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "20": { "$value": "80px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "xl":   { "$value": "16px",  "$type": "dimension" },
    "2xl":  { "$value": "24px",  "$type": "dimension" },
    "full": { "$value": "9999px","$type": "dimension" }
  },
  "typography": {
    "display": {
      "font-family": { "$value": "Inter",     "$type": "fontFamily" },
      "font-weight": { "$value": "700",        "$type": "fontWeight" },
      "font-size":   { "$value": "56px",       "$type": "fontSize"  },
      "line-height": { "$value": "64px",       "$type": "lineHeight"},
      "letter-spacing": { "$value": "-1.5px",  "$type": "letterSpacing" }
    },
    "h1": {
      "font-family": { "$value": "Inter",   "$type": "fontFamily" },
      "font-weight": { "$value": "700",      "$type": "fontWeight" },
      "font-size":   { "$value": "36px",     "$type": "fontSize"  },
      "line-height": { "$value": "44px",     "$type": "lineHeight"},
      "letter-spacing": { "$value": "-0.5px","$type": "letterSpacing" }
    },
    "h2": {
      "font-family": { "$value": "Inter",   "$type": "fontFamily" },
      "font-weight": { "$value": "600",      "$type": "fontWeight" },
      "font-size":   { "$value": "28px",     "$type": "fontSize"  },
      "line-height": { "$value": "36px",     "$type": "lineHeight"},
      "letter-spacing": { "$value": "-0.3px","$type": "letterSpacing" }
    },
    "h3": {
      "font-family": { "$value": "Inter",  "$type": "fontFamily" },
      "font-weight": { "$value": "600",     "$type": "fontWeight" },
      "font-size":   { "$value": "20px",    "$type": "fontSize"  },
      "line-height": { "$value": "28px",    "$type": "lineHeight"},
      "letter-spacing": { "$value": "0px",  "$type": "letterSpacing" }
    },
    "body": {
      "font-family": { "$value": "Inter",  "$type": "fontFamily" },
      "font-weight": { "$value": "400",     "$type": "fontWeight" },
      "font-size":   { "$value": "16px",    "$type": "fontSize"  },
      "line-height": { "$value": "24px",    "$type": "lineHeight"},
      "letter-spacing": { "$value": "0px",  "$type": "letterSpacing" }
    },
    "label": {
      "font-family": { "$value": "Inter",  "$type": "fontFamily" },
      "font-weight": { "$value": "500",     "$type": "fontWeight" },
      "font-size":   { "$value": "14px",    "$type": "fontSize"  },
      "line-height": { "$value": "20px",    "$type": "lineHeight"},
      "letter-spacing": { "$value": "0.1px","$type": "letterSpacing" }
    },
    "caption": {
      "font-family": { "$value": "Inter",  "$type": "fontFamily" },
      "font-weight": { "$value": "400",     "$type": "fontWeight" },
      "font-size":   { "$value": "12px",    "$type": "fontSize"  },
      "line-height": { "$value": "16px",    "$type": "lineHeight"},
      "letter-spacing": { "$value": "0.2px","$type": "letterSpacing" }
    },
    "code": {
      "font-family": { "$value": "'JetBrains Mono', 'Fira Code', monospace", "$type": "fontFamily" },
      "font-weight": { "$value": "400",     "$type": "fontWeight" },
      "font-size":   { "$value": "14px",    "$type": "fontSize"  },
      "line-height": { "$value": "22px",    "$type": "lineHeight"},
      "letter-spacing": { "$value": "0px",  "$type": "letterSpacing" }
    }
  }
}
